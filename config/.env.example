# VaultX Email Configuration Example
# Copy this file to .env and update with your actual credentials

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
FROM_EMAIL=noreply@vaultx.com
FROM_NAME=VaultX Security

# Database Configuration
DB_HOST=localhost
DB_NAME=secure_vault
DB_USER=root
DB_PASS=

# OTP Settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
